---
interface Props {
    target: string;
    placeholder?: string;
}

const {
    target,
    placeholder = "Cerca..."
} = Astro.props;
---

<div
    class="search"
    data-content-search
    data-search-target={target}
>
    <label
        class="search-label"
        for={`search-${target}`}
    >
        Cerca
    </label>

    <div class="search-control">
        <input
            id={`search-${target}`}
            type="search"
            placeholder={placeholder}
            autocomplete="off"
            data-search-input
        />

        <button
            class="clear-button"
            type="button"
            aria-label="Cancella ricerca"
            title="Cancella ricerca"
            data-search-clear
            hidden
        >
            ×
        </button>
    </div>
</div>

<style>
    .search {
        margin-top: 2rem;
    }

    .search-label {
        display: block;

        margin-bottom: 0.75rem;

        color: var(--color-text-secondary);

        font-size: 0.85rem;
        font-weight: 600;
    }

    .search-control {
        position: relative;

        max-width: 500px;
    }

    input {
        width: 100%;

        padding: 0.75rem 2.75rem 0.75rem 1rem;

        color: var(--color-text);
        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 8px;

        font: inherit;

        transition:
            border-color var(--transition),
            background var(--transition);
    }

    input:hover {
        border-color: var(--color-text-secondary);
    }

    input:focus {
        border-color: var(--color-primary);
        outline: none;
    }

    input::placeholder {
        color: var(--color-text-secondary);
    }

    .clear-button {
        position: absolute;

        top: 50%;
        right: 0.65rem;

        width: 30px;
        height: 30px;

        padding: 0;

        transform: translateY(-50%);

        color: var(--color-text-secondary);
        background: transparent;

        border: 0;
        border-radius: 6px;

        font-size: 1.25rem;

        cursor: pointer;
    }

    .clear-button:hover {
        color: var(--color-text);
        background: var(--color-background);
    }
</style>

<script>
    const searches =
        document.querySelectorAll("[data-content-search]");

    searches.forEach((search) => {
        const target =
            search.getAttribute("data-search-target");

        const input =
            search.querySelector("[data-search-input]");

        const clearButton =
            search.querySelector("[data-search-clear]");

        if (
            !target ||
            !(input instanceof HTMLInputElement) ||
            !(clearButton instanceof HTMLButtonElement)
        ) {
            return;
        }

        const items =
            document.querySelectorAll(
                `[data-filter-group="${target}"]`
            );

        const applySearch = () => {
            const query =
                input.value
                    .trim()
                    .toLocaleLowerCase("it");

            clearButton.hidden =
                query.length === 0;

            items.forEach((item) => {
                if (!(item instanceof HTMLElement)) {
                    return;
                }

                item.dataset.matchesSearch = String(
                    !query ||
                    (
                        item.dataset.search ?? ""
                    ).includes(query)
                );

                updateVisibility(item);
            });
        };

        input.addEventListener(
            "input",
            applySearch
        );

        clearButton.addEventListener(
            "click",
            () => {
                input.value = "";

                applySearch();

                input.focus();
            }
        );
    });

    function updateVisibility(item: HTMLElement) {
        const matchesSearch =
            item.dataset.matchesSearch !== "false";

        const matchesFilter =
            item.dataset.matchesFilter !== "false";

        item.hidden =
            !(matchesSearch && matchesFilter);
    }
</script>