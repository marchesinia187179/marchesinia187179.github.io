---
interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---

{
    tags.length > 0 && (
        <div class="tags">
            {
                tags.map((tag) => (
                    <span>{tag}</span>
                ))
            }
        </div>
    )
}

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;

        gap: 0.5rem;

        margin-top: 1rem;
    }

    .tags span {
        padding: 0.25rem 0.65rem;

        color: var(--color-text);
        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 999px;

        font-size: 0.8rem;

        transition:
            background var(--transition),
            border-color var(--transition),
            color var(--transition);
    }
</style>