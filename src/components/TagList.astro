---
interface Tags {
    areas: string[];
    technologies: string[];
    languages: string[];
}

interface Props {
    tags: Tags;
}

const { tags } = Astro.props;

const groups = [
    {
        key: "areas",
        label: "Aree",
        values: tags.areas,
    },
    {
        key: "technologies",
        label: "Tecnologie",
        values: tags.technologies,
    },
    {
        key: "languages",
        label: "Linguaggi",
        values: tags.languages,
    },
].filter((group) => group.values.length > 0);
---

{
    groups.length > 0 && (
        <div class="tag-groups">
            {
                groups.map((group) => (
                    <div class="tag-group">
                        <span class="tag-label">
                            {group.label}
                        </span>

                        <div class="tags">
                            {
                                group.values.map((tag) => (
                                    <span class="tag">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                ))
            }
        </div>
    )
}

<style>
    .tag-groups {
        display: flex;
        flex-direction: column;

        gap: 0.75rem;

        margin-top: 1rem;
    }

    .tag-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 0.5rem;
    }

    .tag-label {
        color: var(--color-text-secondary);

        font-size: 0.75rem;
        font-weight: 600;

        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;

        gap: 0.5rem;
    }

    .tag {
        padding: 0.25rem 0.65rem;

        color: var(--color-text);
        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 999px;

        font-size: 0.8rem;

        transition:
            background var(--transition),
            border-color var(--transition),
            color var(--transition);
    }
</style>