---
const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <nav class="nav">
        <a class="logo" href="/">
            AM
        </a>

        <div class="nav-links">
            <a
                href="/"
                class:list={{ active: currentPath === "/" }}
            >
                Home
            </a>

            <a
                href="/blog"
                class:list={{ active: currentPath.startsWith("/blog") }}
            >
                Blog
            </a>

            <a
                href="/projects"
                class:list={{ active: currentPath.startsWith("/projects") }}
            >
                Progetti
            </a>

            <a
                href="/about"
                class:list={{ active: currentPath.startsWith("/about") }}
            >
                Chi sono
            </a>
        </div>
    </nav>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);

        border-bottom: 1px solid var(--color-border);
    }

    .nav {
        width: min(
            calc(100% - 2rem),
            var(--content-width)
        );

        height: 64px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        color: var(--color-text);

        font-size: 1.2rem;
        font-weight: 700;

        text-decoration: none;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-links a {
        color: var(--color-text-secondary);

        font-size: 0.95rem;
        font-weight: 500;

        text-decoration: none;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--color-text);
    }

    @media (max-width: 600px) {
        .nav-links {
            gap: 1rem;
        }

        .nav-links a {
            font-size: 0.85rem;
        }
    }
</style>