---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const allTags = [
    ...project.data.tags.areas,
    ...project.data.tags.technologies,
    ...project.data.tags.languages,
];
---

<article
    class="card"
    data-filter-group="projects"
    data-tags={allTags.join("|")}
    data-areas={project.data.tags.areas.join("|")}
    data-technologies={project.data.tags.technologies.join("|")}
    data-languages={project.data.tags.languages.join("|")}
    data-search={[
        project.data.title,
        project.data.description
    ]
        .join(" ")
        .toLocaleLowerCase("it")}
>
    {
        project.data.image && (
            <a
                class="image-link"
                href={`/projects/${project.id}`}
                aria-label={`Apri il progetto ${project.data.title}`}
            >
                <img
                    class="project-image"
                    src={project.data.image}
                    alt={project.data.imageAlt ?? ""}
                    loading="lazy"
                />
            </a>
        )
    }

    <div class="card-content">
        <div class="project-meta">
            {
                project.data.period && (
                    <span>{project.data.period}</span>
                )
            }

            <span class:list={[
                "status",
                `status-${project.data.status}`
            ]}>
                {
                    project.data.status === "completed"
                        ? "Completato"
                        : project.data.status === "in-progress"
                            ? "In corso"
                            : "Pianificato"
                }
            </span>
        </div>

        <h2>
            <a href={`/projects/${project.id}`}>
                {project.data.title}
            </a>
        </h2>

        <p>
            {project.data.description}
        </p>

        <TagList tags={project.data.tags} />

        <a
            class="project-link"
            href={`/projects/${project.id}`}
        >
            Apri progetto
            <span aria-hidden="true">→</span>
        </a>
    </div>
</article>


<style>
    .card {
        overflow: hidden;

        display: flex;
        flex-direction: column;

        height: 100%;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);

        transition:
            transform var(--transition),
            border-color var(--transition);
    }

    .card:hover {
        transform: translateY(-3px);
        border-color: var(--color-primary);
    }

    .image-link {
        display: block;

        overflow: hidden;

        aspect-ratio: 16 / 9;

        background: var(--color-background);
    }

    .project-image {
        width: 100%;
        height: 100%;

        object-fit: cover;

        transition: transform 0.3s ease;
    }

    .card:hover .project-image {
        transform: scale(1.025);
    }

    .card-content {
        display: flex;
        flex: 1;
        flex-direction: column;

        padding: 1.5rem;
    }

    time {
        color: var(--color-text-secondary);

        font-size: 0.85rem;
    }

    h2 {
        margin: 0.5rem 0 0;
    }

    h2 a {
        color: var(--color-text);
        text-decoration: none;
    }

    h2 a:hover {
        color: var(--color-primary);
    }

    p {
        margin: 1rem 0 0;

        color: var(--color-text-secondary);
    }

    .project-link {
        margin-top: auto;
        padding-top: 1.5rem;

        display: inline-flex;
        align-items: center;

        gap: 0.4rem;

        width: fit-content;

        font-weight: 600;
    }

    .project-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 1rem;

        color: var(--color-text-secondary);

        font-size: 0.85rem;
    }

    .status {
        padding: 0.2rem 0.55rem;

        border: 1px solid var(--color-border);
        border-radius: 999px;

        white-space: nowrap;
    }
</style>