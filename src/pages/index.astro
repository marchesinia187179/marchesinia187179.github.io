---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ArticleCard from "../components/ArticleCard.astro";

import { getCollection } from "astro:content";

const projects = (
    await getCollection(
        "projects",
        ({ data }) =>
            !data.draft &&
            data.featured
    )
)
    .sort(
        (a, b) =>
            b.data.date.valueOf() -
            a.data.date.valueOf()
    )
    .slice(0, 3);

const posts = (
    await getCollection(
        "blog",
        ({ data }) => !data.draft
    )
)
    .sort(
        (a, b) =>
            b.data.date.valueOf() -
            a.data.date.valueOf()
    )
    .slice(0, 3);
---

<Layout
    title="Alessandro Marchesini | Ingegneria Informatica"
    description="Portfolio di Alessandro Marchesini: progetti e approfondimenti su cybersecurity, machine learning, sistemi informatici, embedded e infrastrutture."
>
    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="hero">
        <p class="hero-label">
            Ingegneria Informatica
        </p>

        <h1>
            Ciao, sono Alessandro.
        </h1>

        <p class="hero-description">
            Mi interesso alla progettazione di sistemi informatici
            che integrano cybersecurity, machine learning,
            infrastrutture software e dispositivi embedded.
            In questo portfolio raccolgo progetti, esperienze
            e approfondimenti sviluppati durante il mio percorso.
        </p>

        <div class="hero-actions">
            <a
                class="button primary"
                href="/projects"
            >
                Esplora i progetti
            </a>

            <a
                class="button secondary"
                href="/about"
            >
                Chi sono
            </a>

            <a
                class="button secondary"
                href="https://github.com/marchesinia187179"
                target="_blank"
                rel="noopener noreferrer"
            >
                GitHub
            </a>
        </div>
    </section>


    <!-- =====================================================
         AREE PRINCIPALI
         ===================================================== -->

    <section class="section">
        <div class="section-heading">
            <div>
                <p class="section-label">
                    Interessi
                </p>

                <h2>
                    Aree principali
                </h2>
            </div>
        </div>

        <div class="interests">
            <article>
                <h3>
                    Cybersecurity
                </h3>

                <p>
                    Sicurezza dei sistemi, delle reti
                    e delle infrastrutture informatiche.
                </p>
            </article>

            <article>
                <h3>
                    Machine Learning
                </h3>

                <p>
                    Applicazione di tecniche di apprendimento
                    automatico a problemi e sistemi reali.
                </p>
            </article>

            <article>
                <h3>
                    Systems & Embedded
                </h3>

                <p>
                    Sistemi informatici, elaborazione efficiente
                    e integrazione software-hardware.
                </p>
            </article>

            <article>
                <h3>
                    Cloud & Infrastructure
                </h3>

                <p>
                    Architetture, servizi e infrastrutture
                    per sistemi distribuiti e applicazioni.
                </p>
            </article>
        </div>
    </section>


    <!-- =====================================================
         PROGETTI IN EVIDENZA
         ===================================================== -->

    {
        projects.length > 0 && (
            <section class="section">
                <div class="section-heading">
                    <div>
                        <p class="section-label">
                            Portfolio
                        </p>

                        <h2>
                            Progetti in evidenza
                        </h2>
                    </div>

                    <a href="/projects">
                        Tutti i progetti →
                    </a>
                </div>

                <div class="projects">
                    {
                        projects.map(
                            (project) => (
                                <ProjectCard
                                    project={project}
                                />
                            )
                        )
                    }
                </div>
            </section>
        )
    }


    <!-- =====================================================
         ULTIMI ARTICOLI
         ===================================================== -->

    {
        posts.length > 0 && (
            <section class="section">
                <div class="section-heading">
                    <div>
                        <p class="section-label">
                            Blog
                        </p>

                        <h2>
                            Ultimi articoli
                        </h2>
                    </div>

                    <a href="/blog">
                        Tutti gli articoli →
                    </a>
                </div>

                <div class="posts">
                    {
                        posts.map(
                            (post) => (
                                <ArticleCard
                                    post={post}
                                />
                            )
                        )
                    }
                </div>
            </section>
        )
    }


    <!-- =====================================================
         ABOUT CTA
         ===================================================== -->

    <section class="section">
        <div class="about-cta">
            <div>
                <p class="section-label">
                    Profilo
                </p>

                <h2>
                    Percorso e interessi
                </h2>

                <p>
                    Scopri il mio percorso formativo,
                    gli ambiti che sto approfondendo
                    e gli obiettivi che guidano i miei progetti.
                </p>
            </div>

            <a
                class="button secondary"
                href="/about"
            >
                Scopri di più
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</Layout>

<style>
    /* =====================================================
       HERO
       ===================================================== */

    .hero {
        max-width: 850px;

        padding:
            clamp(3rem, 8vw, 7rem)
            0
            clamp(4rem, 8vw, 7rem);
    }

    .hero-label,
    .section-label {
        margin-bottom: 0.75rem;

        color: var(--color-primary);

        font-size: 0.85rem;
        font-weight: 700;

        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero h1 {
        margin-bottom: 1.5rem;
    }

    .hero-description {
        max-width: 750px;

        margin-bottom: 2rem;

        color: var(--color-text-secondary);

        font-size: clamp(
            1.1rem,
            2vw,
            1.3rem
        );
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 0.75rem;
    }


    /* =====================================================
       BUTTONS
       ===================================================== */

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 0.4rem;

        min-height: 44px;

        padding: 0.65rem 1.1rem;

        border: 1px solid transparent;
        border-radius: 8px;

        font-weight: 600;

        text-decoration: none;

        transition:
            background var(--transition),
            border-color var(--transition),
            color var(--transition);
    }

    .button.primary {
        color: #ffffff;
        background: var(--color-primary);
    }

    .button.primary:hover {
        color: #ffffff;
        background: var(--color-primary-hover);
    }

    .button.secondary {
        color: var(--color-text);
        background: transparent;

        border-color: var(--color-border);
    }

    .button.secondary:hover {
        color: var(--color-text);
        background: var(--color-surface);

        border-color: var(--color-primary);
    }


    /* =====================================================
       SECTIONS
       ===================================================== */

    .section {
        padding: 4rem 0;

        border-top: 1px solid var(--color-border);
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;

        gap: 1rem;

        margin-bottom: 2rem;
    }

    .section-heading h2 {
        margin-bottom: 0;
    }

    .section-heading > a {
        flex-shrink: 0;

        font-weight: 500;
    }


    /* =====================================================
       INTERESTS
       ===================================================== */

    .interests {
        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(220px, 1fr)
            );

        gap: 1rem;
    }

    .interests article {
        padding: 1.5rem;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);

        transition:
            transform var(--transition),
            border-color var(--transition);
    }

    .interests article:hover {
        transform: translateY(-3px);

        border-color: var(--color-primary);
    }

    .interests h3 {
        margin-bottom: 0.75rem;
    }

    .interests p {
        margin-bottom: 0;

        color: var(--color-text-secondary);
    }


    /* =====================================================
       PROJECTS
       ===================================================== */

    .projects {
        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(280px, 1fr)
            );

        gap: 1.5rem;
    }


    /* =====================================================
       POSTS
       ===================================================== */

    .posts {
        display: grid;

        gap: 1rem;
    }


    /* =====================================================
       ABOUT CTA
       ===================================================== */

    .about-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 2rem;

        padding: 2rem;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
    }

    .about-cta h2 {
        margin-bottom: 0.75rem;
    }

    .about-cta p:not(.section-label) {
        max-width: 650px;

        margin-bottom: 0;

        color: var(--color-text-secondary);
    }

    .about-cta .button {
        flex-shrink: 0;
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 700px) {
        .section {
            padding: 3rem 0;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .about-cta {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>