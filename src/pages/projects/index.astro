---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import { getCollection } from "astro:content";

const projects = await getCollection(
    "projects",
    ({ data }) => !data.draft
);

projects.sort(
    (a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = [
    ...new Set(
        projects.flatMap(
            (project) => project.data.tags
        )
    )
].sort((a, b) =>
    a.localeCompare(b, "it")
);
---

<Layout
    title="Progetti | Alessandro Marchesini"
    description="Progetti personali e universitari di Alessandro Marchesini."
>
    <header class="page-header">
        <p class="eyebrow">Portfolio</p>

        <h1>Progetti</h1>

        <p class="introduction">
            Una selezione di progetti accademici e personali
            nell'ambito dell'ingegneria informatica.
        </p>
    </header>

    <FilterBar
        tags={tags}
        target="projects"
    />

    <section class="projects">
        {
            projects.map((project) => (
                <ProjectCard project={project} />
            ))
        }
    </section>
</Layout>

<style>
    .page-header {
        max-width: 750px;
    }

    .eyebrow {
        margin-bottom: 0.75rem;

        color: var(--color-primary);

        font-size: 0.8rem;
        font-weight: 700;

        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .introduction {
        max-width: 650px;

        color: var(--color-text-secondary);

        font-size: 1.1rem;
    }

    .projects {
        display: grid;

        grid-template-columns:
            repeat(auto-fit, minmax(280px, 1fr));

        gap: 1.5rem;

        margin-top: 3rem;
    }
</style>