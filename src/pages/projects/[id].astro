---
import Layout from "../../layouts/Layout.astro";
import TagList from "../../components/TagList.astro";
import {
    getCollection,
    render,
    type CollectionEntry
} from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection(
        "projects",
        ({ data }) => !data.draft
    );

    return projects.map((project) => ({
        params: {
            id: project.id,
        },

        props: {
            project,
        },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<Layout
    title={`${project.data.title} | Alessandro Marchesini`}
    description={project.data.description}
    image={project.data.image ?? "/favicon.svg"}
>
    <article>
        <header>
            <h1>{project.data.title}</h1>

            <div class="project-meta">
                {
                    project.data.period && (
                        <span>{project.data.period}</span>
                    )
                }

                <span>
                    {
                        project.data.status === "completed"
                            ? "Completato"
                            : project.data.status === "in-progress"
                                ? "In corso"
                                : "Pianificato"
                    }
                </span>
            </div>

            <p>
                {project.data.description}
            </p>

            <TagList tags={project.data.tags} />

            {
                (project.data.github || project.data.demo) && (
                    <div class="project-links">
                        {
                            project.data.github && (
                                <a
                                    href={project.data.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Repository GitHub
                                </a>
                            )
                        }

                        {
                            project.data.demo && (
                                <a
                                    href={project.data.demo}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Demo
                                </a>
                            )
                        }
                    </div>
                )
            }
        </header>

        {
            project.data.image && (
                <img
                    class="project-cover"
                    src={project.data.image}
                    alt={project.data.imageAlt ?? ""}
                />
            )
        }

        <hr />

        <Content />
    </article>
</Layout>

<style>
    article {
        max-width: 750px;
        margin: 0 auto;
    }

    article > header {
        margin-bottom: 2rem;
    }

    h1 {
        margin-bottom: 0.5rem;
    }

    time {
        color: #666;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tags span {
        padding: 0.25rem 0.65rem;

        color: var(--color-text);
        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 999px;

        font-size: 0.8rem;

        transition:
            background var(--transition),
            border-color var(--transition),
            color var(--transition);
    }

    hr {
        margin: 2rem 0;
        border: none;
        border-top: 1px solid #ddd;
    }

    .project-cover {
        width: 100%;

        margin: 2rem 0;

        aspect-ratio: 16 / 9;
        object-fit: cover;

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
    }

    .project-meta {
        display: flex;
        flex-wrap: wrap;

        gap: 0.75rem;

        margin-bottom: 1rem;

        color: var(--color-text-secondary);

        font-size: 0.9rem;
    }

    .project-links {
        display: flex;
        flex-wrap: wrap;

        gap: 1rem;

        margin-top: 1.5rem;
    }

    .project-links a {
        font-weight: 600;
    }
</style>