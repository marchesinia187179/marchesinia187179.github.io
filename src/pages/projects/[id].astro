---
import Layout from "../../layouts/Layout.astro";
import TagList from "../../components/TagList.astro";

import {
    getCollection,
    render,
    type CollectionEntry
} from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection(
        "projects",
        ({ data }) => !data.draft
    );

    return projects.map((project) => ({
        params: {
            id: project.id
        },

        props: {
            project
        },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content } = await render(project);

const statusLabel = {
    completed: "Completato",
    "in-progress": "In corso",
    planned: "Pianificato",
}[project.data.status];
---

<Layout
    title={`${project.data.title} | Alessandro Marchesini`}
    description={project.data.description}
    image={project.data.image ?? "/favicon.svg"}
>
    <article class="project">
        <header class="project-header">
            <p class="eyebrow">
                Progetto
            </p>

            <h1>
                {project.data.title}
            </h1>

            <div class="project-meta">
                {
                    project.data.period && (
                        <span>
                            {project.data.period}
                        </span>
                    )
                }

                <span class="status">
                    {statusLabel}
                </span>
            </div>

            <p class="description">
                {project.data.description}
            </p>

            <TagList tags={project.data.tags} />

            {
                (project.data.github || project.data.demo) && (
                    <div class="project-links">
                        {
                            project.data.github && (
                                <a
                                    class="button primary"
                                    href={project.data.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Repository GitHub
                                </a>
                            )
                        }

                        {
                            project.data.demo && (
                                <a
                                    class="button secondary"
                                    href={project.data.demo}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Demo
                                </a>
                            )
                        }
                    </div>
                )
            }
        </header>

        {
            project.data.image && (
                <figure class="project-cover">
                    <img
                        src={project.data.image}
                        alt={project.data.imageAlt ?? ""}
                    />
                </figure>
            )
        }

        <div class="project-content">
            <Content />
        </div>
    </article>
</Layout>


<style>
    .project {
        max-width: var(--article-width);
        margin: 0 auto;
    }

    .project-header {
        margin-bottom: 2.5rem;
    }

    .eyebrow {
        margin-bottom: 0.75rem;

        color: var(--color-primary);

        font-size: 0.8rem;
        font-weight: 700;

        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h1 {
        margin-bottom: 1rem;
    }

    .project-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 0.75rem;

        margin-bottom: 1.5rem;

        color: var(--color-text-secondary);

        font-size: 0.9rem;
    }

    .status {
        padding: 0.2rem 0.6rem;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 999px;
    }

    .description {
        max-width: 650px;

        margin-bottom: 1.25rem;

        color: var(--color-text-secondary);

        font-size: 1.1rem;
        line-height: 1.7;
    }

    .project-links {
        display: flex;
        flex-wrap: wrap;

        gap: 0.75rem;

        margin-top: 1.5rem;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 0.7rem 1rem;

        border: 1px solid var(--color-border);
        border-radius: 8px;

        font-weight: 600;

        text-decoration: none;

        transition:
            background var(--transition),
            border-color var(--transition),
            color var(--transition);
    }

    .button.primary {
        color: var(--color-on-primary);
        background: var(--color-primary);
        border-color: var(--color-primary);
    }

    .button.primary:hover {
        background: var(--color-primary-hover);
        border-color: var(--color-primary-hover);
    }

    .button.secondary {
        color: var(--color-text);
        background: var(--color-surface);
    }

    .button.secondary:hover {
        border-color: var(--color-primary);
    }

    .project-cover {
        overflow: hidden;

        margin: 0 0 3rem;

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);

        background: var(--color-surface);
    }

    .project-cover img {
        display: block;

        width: 100%;
        height: auto;
    }

    .project-content {
        padding-top: 2.5rem;

        border-top: 1px solid var(--color-border);
    }

    .project-content :global(h2) {
        margin-top: 3rem;
        margin-bottom: 1rem;
    }

    .project-content :global(h2:first-child) {
        margin-top: 0;
    }

    .project-content :global(h3) {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .project-content :global(p),
    .project-content :global(li) {
        color: var(--color-text-secondary);
    }

    .project-content :global(p) {
        line-height: 1.8;
    }

    .project-content :global(li) {
        margin-bottom: 0.35rem;
    }

    .project-content :global(strong) {
        color: var(--color-text);
    }

    .project-content :global(code) {
        padding: 0.15rem 0.35rem;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: 4px;
    }

    @media (max-width: 600px) {
        .description {
            font-size: 1rem;
        }

        .project-cover {
            margin-bottom: 2rem;
        }

        .project-content {
            padding-top: 2rem;
        }
    }
</style>