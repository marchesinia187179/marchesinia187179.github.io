---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import ContentSearch from "../../components/ContentSearch.astro";
import { getCollection } from "astro:content";

const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft
);

posts.sort(
    (a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = [
    ...new Set(
        posts.flatMap(
            (post) => post.data.tags
        )
    )
].sort((a, b) =>
    a.localeCompare(b, "it")
);
---

<Layout
    title="Blog | Alessandro Marchesini"
    description="Articoli e approfondimenti di Alessandro Marchesini."
>
    <h1>Blog</h1>

    <p>
        Articoli, appunti e approfondimenti.
    </p>

    {
        posts.length > 0 ? (
            <>
                <ContentSearch
                    target="blog"
                    placeholder="Cerca negli articoli..."
                />

                <FilterBar
                    tags={tags}
                    target="blog"
                />

                <section class="posts">
                    {
                        posts.map((post) => (
                            <ArticleCard post={post} />
                        ))
                    }
                </section>
            </>
        ) : (
            <div class="empty-state">
                <h2>Nessun articolo pubblicato</h2>

                <p>
                    I primi approfondimenti saranno pubblicati
                    prossimamente.
                </p>
            </div>
        )
    }
</Layout>

<style>
    .posts {
        display: grid;
        gap: 1rem;
        margin-top: 2.5rem;
    }

    .empty-state {
        margin-top: 3rem;
        padding: 2rem;

        background: var(--color-surface);

        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
    }

    .empty-state h2 {
        margin-bottom: 0.5rem;

        font-size: 1.2rem;
    }

    .empty-state p {
        margin: 0;

        color: var(--color-text-secondary);
    }
</style>