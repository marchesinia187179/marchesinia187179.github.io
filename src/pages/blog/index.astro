---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft
);

posts.sort(
    (a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
    title="Blog | Portfolio"
    description="Articoli del mio blog personale"
>
    <h1>Blog</h1>

    <p>
        Articoli, appunti e progetti personali.
    </p>

    <section class="posts">
        {
            posts.map((post) => (
                <article>
                    <h2>
                        <a href={`/blog/${post.id}`}>
                            {post.data.title}
                        </a>
                    </h2>

                    <time datetime={post.data.date.toISOString()}>
                        {post.data.date.toLocaleDateString("it-IT")}
                    </time>

                    <p>
                        {post.data.description}
                    </p>

                    <div class="tags">
                        {
                            post.data.tags.map((tag) => (
                                <span>{tag}</span>
                            ))
                        }
                    </div>
                </article>
            ))
        }
    </section>
</Layout>

<style>
    .posts {
        display: grid;
        gap: 2rem;
        margin-top: 2rem;
    }

    article {
        padding-bottom: 2rem;
        border-bottom: 1px solid #ddd;
    }

    h2 {
        margin-bottom: 0.5rem;
    }

    h2 a {
        color: inherit;
        text-decoration: none;
    }

    h2 a:hover {
        text-decoration: underline;
    }

    time {
        color: #666;
        font-size: 0.9rem;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tags span {
        padding: 0.25rem 0.6rem;
        background: #eee;
        border-radius: 0.4rem;
        font-size: 0.85rem;
    }
</style>
