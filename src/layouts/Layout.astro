---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Alessandro Marchesini",
    description = "Portfolio personale di Alessandro Marchesini"
} = Astro.props;
---

<!doctype html>

<html lang="it">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width"
        />

        <meta
            name="description"
            content={description}
        />

        <title>{title}</title>
    </head>

    <body>
        <Header />

        <main class="main-content">
            <slot />
        </main>

        <Footer />
</body>
</html>

<style>
    .main-content {
        width: min(
            calc(100% - 2rem),
            var(--content-width)
        );

        margin: 0 auto;
        padding: 4rem 0;
    }

    @media (max-width: 600px) {
        .main-content {
            padding: 2.5rem 0;
        }
    }
</style>